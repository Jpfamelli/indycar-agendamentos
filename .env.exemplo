# Configuração da Agenda IndyCar — copie este arquivo para .env e preencha.
# O arquivo .env é lido por process.loadEnvFile() (Node 22+).
# NUNCA use setx / variável de ambiente do Windows para isso.

# Projeto Supabase que guarda CRM + Agenda + Atendimento
SUPABASE_URL=https://nppfqhavqahapmugnyng.supabase.co

# Chave service_role (Supabase > Project Settings > API Keys).
# Ela IGNORA o RLS e é o "servidor da oficina".
# NUNCA envie esta chave para o navegador nem versione este arquivo no git.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Opcionais
# ---------------------------------------------------------------------------
# PORT=3000

# Token do feed do Google Agenda. Se ficar vazio, é gerado automaticamente na
# primeira subida e guardado em agenda_integracoes.ics_token.
# ICS_TOKEN=

# Importação do CodeWords: só UMA instância deve importar.
# IMPORT_ENABLED=1     liga a importação nesta máquina
# IMPORT_DISABLED=1    desliga a importação nesta máquina
# MARK_IMPORTED=1      marca os agendamentos como importados no workflow

# Espelho local -> cloud. Com local e cloud no MESMO Supabase, deixe desligado.
# MIRROR_DISABLED=1

# Credenciais opcionais da IA/CodeWords (preenchem agenda_ia_config se estiver vazia)
# ANTHROPIC_API_KEY=
# CW_API_KEY=
# CW_SERVICE_ID=
# CW_DB_SERVICE_ID=
# CW_NOSHOW_SERVICE_ID=
# CW_CONNECT_SERVICE_ID=
# CW_DEVICE_ID=
