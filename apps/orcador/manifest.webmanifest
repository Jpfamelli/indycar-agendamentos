{
  "id": "/",
  "name": "Orçador IndyCar",
  "short_name": "Orçador",
  "description": "Orçamentos de oficina com IA: a IA entende o pedido, o sistema calcula o preço.",
  "lang": "pt-BR",
  "dir": "ltr",
  "start_url": "/#/painel",
  "scope": "/",
  "display": "standalone",
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "orientation": "any",
  "background_color": "#0a0a0b",
  "theme_color": "#0a0a0b",
  "categories": [
    "business",
    "productivity"
  ],
  "icons": [
    { "src": "/icone.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/icone-maskable.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "maskable" },
    { "src": "/icone-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icone-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icone-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Nova cotação",
      "short_name": "Cotar",
      "description": "Escrever um pedido e montar o orçamento",
      "url": "/#/cotacao",
      "icons": [
        {
          "src": "/icone-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Orçamentos",
      "short_name": "Orçamentos",
      "description": "Ver os orçamentos enviados e aprovados",
      "url": "/#/historico",
      "icons": [
        {
          "src": "/icone-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
