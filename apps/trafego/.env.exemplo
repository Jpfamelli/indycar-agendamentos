# ============================================================
# IndyCar — Central de Tráfego Pago
# Copie este arquivo para ".env" e preencha. Ele fica só no seu PC
# (o .gitignore impede que vá para o GitHub). Depois: node server.js
# ============================================================

# ---- Banco (o mesmo do CRM, da Agenda e do Atendimento) ----
SUPABASE_URL=

# Chave publicável — usada pelo navegador na tela de login.
SUPABASE_ANON_KEY=

# Chave service_role — o servidor usa para ler/gravar ignorando o RLS.
# Onde pegar: Supabase → Settings → API Keys → "Reveal" na linha service_role.
SUPABASE_SERVICE_ROLE_KEY=

# ---- IA (leitura do dia no relatório) ----
# Sem ela o relatório sai só com os números, sem o parágrafo de diagnóstico.
# Onde pegar: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Modelo usado na leitura do dia (opcional).
ADS_MODELO_IA=

# ---- Porta ----
PORT=3400

# ---- Piloto automático ----
# 1 liga os timers dentro do servidor (sync de hora em hora, radar e
# relatório diário). Deixe em 0 se for disparar por fora (cron/Render free).
ADS_AUTOMATICO=0

# Chave para disparar as rotinas por HTTP (cron externo, Render, etc.):
#   POST /api/cron/sync?chave=...   /api/cron/radar   /api/cron/relatorio
ADS_CRON_TOKEN=

# ---- Modo demonstração / sem chaves ----
# Com 1, o painel usa dados fabricados (fonte='demo') para você ver o
# sistema funcionando antes das chaves de Meta e Google saírem. Sem chave
# real e sem dado nenhum, o servidor cria a demonstração sozinho ao subir.
ADS_DEMO=1
# O relatório diário com números de demonstração NÃO vai por WhatsApp
# (só grava a prévia). Ponha 1 só para testar o caminho da fila.
ADS_DEMO_ENVIA=0
